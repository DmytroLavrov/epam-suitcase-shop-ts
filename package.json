{
  "name": "fundamentals-project-ts-template",
  "version": "1.0.0",
  "description": "Capstone Project TS Template",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "sass:compile": "sass src/scss/main.scss:dist/css/main.css",
    "sass:watch": "sass --watch src/scss:dist/css",
    "ts:compile": "tsc",
    "ts:watch": "tsc -w",
    "start:dev": "live-server --open=src/index.html",
    "dev": "npm-run-all --parallel sass:watch ts:watch start:dev",
    "build": "npm run sass:compile && npm run ts:compile",
    "lint": "npm run lint:ts && npm run lint:scss",
    "lint:ts": "eslint src/ts/**/*.ts",
    "lint:scss": "stylelint src/scss/**/*.scss",
    "lint:fix": "npm run lint:ts -- --fix && npm run lint:scss -- --fix"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "keywords": [],
  "author": "Dmytro Lavrov",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^10.2.0",
    "live-server": "^1.2.2",
    "npm-run-all": "^4.1.5",
    "sass": "^1.99.0",
    "stylelint": "^17.7.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.0.0",
    "typescript": "^6.0.2"
  }
}
